#!/usr/bin/env bash
set -Eeuo pipefail

SERVICE="${1:?service required}"
SHA="${2:?sha required}"
TARBALL="${3:?tarball required}"

case "$SERVICE" in
  main-server|customer-server|hoizr-workers) ;;
  *)
    echo "Unknown service: $SERVICE"
    exit 2
    ;;
esac

STACK="/home/hoizr/hoizr-stack"
RELEASES="/home/hoizr/releases/$SERVICE"
LINK="$STACK/$SERVICE"
RELEASE="$RELEASES/$SHA"
ENV_FILE="/home/hoizr/env/$SERVICE.env"
LOCK_FILE="/home/hoizr/.deploy.lock"

exec 9>"$LOCK_FILE"
flock -w 900 9 || {
  echo "Could not acquire deploy lock"
  exit 1
}

mkdir -p "$RELEASES"

[ -f "$TARBALL" ] || {
  echo "Missing tarball: $TARBALL"
  exit 1
}

[ -f "$ENV_FILE" ] || {
  echo "Missing env file: $ENV_FILE"
  exit 1
}

OLD_TARGET=""
if [ -L "$LINK" ]; then
  OLD_TARGET="$(readlink -f "$LINK")"
elif [ -d "$LINK" ]; then
  OLD_TARGET="$LINK"
fi

rollback() {
  echo "ROLLBACK: $1"
  if [ -n "$OLD_TARGET" ] && [ -d "$OLD_TARGET" ]; then
    ln -sfnT "$OLD_TARGET" "$LINK"
    pm2 restart "$SERVICE" --update-env || true
  fi
  rm -rf "$RELEASE"
  exit 1
}

health_check() {
  case "$SERVICE" in
    main-server)
      curl -fsS "http://127.0.0.1:4000/health" >/dev/null
      ;;
    customer-server)
      curl -fsS "http://127.0.0.1:4001/" >/dev/null
      ;;
    hoizr-workers)
      true
      ;;
  esac
}

echo "Deploying $SERVICE @ $SHA"
echo "Release path: $RELEASE"

rm -rf "$RELEASE"
mkdir -p "$RELEASE"
tar -xzf "$TARBALL" -C "$RELEASE"
ln -sfn "$ENV_FILE" "$RELEASE/.env"

cd "$RELEASE"

if [ "$SERVICE" = "hoizr-workers" ]; then
  corepack enable || true
  pnpm install --frozen-lockfile || rollback "pnpm install failed"
  NODE_OPTIONS="--max-old-space-size=768" pnpm build || rollback "pnpm build failed"
else
  npm ci --legacy-peer-deps || rollback "npm ci failed"
  NODE_OPTIONS="--max-old-space-size=768" npm run build || rollback "npm build failed"
fi

[ -f "$RELEASE/dist/index.js" ] || rollback "dist/index.js missing"

if [ -e "$LINK" ] && [ ! -L "$LINK" ]; then
  LEGACY="$RELEASES/legacy-$(date +%s)"
  mv "$LINK" "$LEGACY"
  OLD_TARGET="$LEGACY"
fi

ln -sfnT "$RELEASE" "$LINK"
pm2 restart "$SERVICE" --update-env || rollback "pm2 restart failed"

sleep 3
PID1="$(pm2 pid "$SERVICE" 2>/dev/null || true)"
sleep 8
PID2="$(pm2 pid "$SERVICE" 2>/dev/null || true)"

if [ -z "$PID2" ] || [ "$PID1" != "$PID2" ]; then
  rollback "process restarted or crashed during smoke window"
fi

health_check || rollback "health check failed"

pm2 save >/dev/null 2>&1 || true
rm -f "$TARBALL"

mapfile -t OLD_RELEASES < <(
  find "$RELEASES" -mindepth 1 -maxdepth 1 -type d ! -name "$(basename "$RELEASE")" \
    -printf "%T@ %p\n" | sort -rn | tail -n +6 | cut -d" " -f2-
)

if [ "${#OLD_RELEASES[@]}" -gt 0 ]; then
  rm -rf "${OLD_RELEASES[@]}"
fi

echo "Deploy OK: $SERVICE @ $SHA"
