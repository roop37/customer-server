# =============================================================================
# customer-server — customer-facing GraphQL API (default port: 4001)
# =============================================================================
# Copy to `.env` and fill in. The Zod schema in src/utils/environment.ts
# refuses to boot if any non-optional value is missing.
#
# Auth-critical secrets (PUBLIC_KEY, PRIVATE_KEY, COOKIE_SECRET,
# ENCRYPTION_KEY, CLIENT_ENCRYPTION_KEY) MUST be identical to the same
# vars in main-server/.env — cookies issued by one are validated by
# the other.

# ---- MongoDB (same cluster as main-server + hoizr-workers) ------------------
DB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=dev2

# ---- Redis (same instance as main-server + hoizr-workers) -------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_TLS=false

# ---- JWT key pair (PEM) — MUST match main-server ----------------------------
PUBLIC_KEY=
PRIVATE_KEY=

# ---- Symmetric secrets — MUST match main-server -----------------------------
ENCRYPTION_KEY=
CLIENT_ENCRYPTION_KEY=
COOKIE_SECRET=

# ---- Application URLs -------------------------------------------------------
APP_URL=http://localhost:3002           # hoizr-client origin
PORT=4001
SERVER_ENV=development                  # development | staging | production

# Optional: cookie domain. Set to ".hoizr.com" (note leading dot) when
# you want auth cookies to span subdomains in staging/prod.
# COOKIE_DOMAIN=.hoizr.com

# Optional: comma-separated CORS origin allowlist. Add every Vercel
# preview domain the customer frontend deploys to in dev.
# CUSTOMER_CORS_ORIGINS=https://app.dev.hoizr.com,https://hoizr-client-git-dev-<org>.vercel.app
CUSTOMER_CORS_ORIGINS=http://localhost:3002

# ---- Razorpay payments ------------------------------------------------------
# Used for:
#   • Customer ticket order creation + signature verification
#   • Artist merch order creation + signature verification
#   • Receiving ticket payment.captured / refund.processed webhooks
#
# Same values as in main-server/.env (one merchant, one key pair).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Google OAuth (customer phone+Google login) -----------------------------
# Web client ID from Google Cloud Console → APIs & Services → Credentials.
# Same value goes into hoizr-client/.env.local as NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID.
GOOGLE_OAUTH_CLIENT_ID=

# ---- Instagram Connect (Instagram API with Instagram Login) -----------------
# Customers connect their Instagram on /me/profile so other ticket-holders
# can see them on event pages. The integration is gated on env vars:
# when META_INSTAGRAM_APP_ID is blank, the connect mutation falls back
# to the deterministic stub fetcher so the feature stays demoable.
#
# Provisioning runbook: docs/INSTAGRAM_CONNECT.md §4.
#
# Redirect URIs that MUST be registered on the Meta app's
# "Instagram API setup with Instagram Login" → OAuth Settings (byte-for-
# byte; Meta rejects any callback whose URI isn't on this list):
#   https://orderapi.hoizr.com/auth/instagram/callback        (production)
#   https://dev-orderapi.hoizr.com/auth/instagram/callback    (staging)
#   https://<your-ngrok-host>.ngrok-free.app/auth/instagram/callback (local dev)
#
# Deauthorize callback URL  → https://orderapi.hoizr.com/auth/instagram/deauthorize
# Data deletion request URL → https://orderapi.hoizr.com/auth/instagram/deletion
# (Both handlers are TODO — see INSTAGRAM_CONNECT.md §6.2 + §6.3.)
#
# App ID + Secret below are the placeholders the user provided for
# initial wiring. Replace with the real Instagram (NOT Facebook) App ID
# and Secret from developers.facebook.com → your app → Instagram product
# page once the dashboard is configured.
META_INSTAGRAM_APP_ID=1310219364022389
META_INSTAGRAM_APP_SECRET=e95e1d189bcbdc726bb5ace2e6eee582

# Pick the URI that matches the env you're booting. ALL THREE must be
# registered on Meta's OAuth Settings (above) regardless of which one
# you use here.
META_INSTAGRAM_REDIRECT_URI=https://dev-orderapi.hoizr.com/auth/instagram/callback

# Pre-generated for this checkout (`openssl rand -hex 32`). Generate
# fresh values per environment in production — DO NOT share these
# between dev/staging/prod, and DO NOT reuse JWT/cookie secrets.
META_INSTAGRAM_STATE_SECRET=98ca2aa7ec15584a90bef9ffad3d5931569161edb8c63868ba0c3e1187b296d6
META_INSTAGRAM_TOKEN_KEY=4b31b45d7ccf872b460f98687d76a2294b163f04fa9308eb39831df19fa6e18c

# Where to bounce the browser to after the OAuth callback finishes.
# The frontend reads ?ig=connected|denied|error from this URL.
META_INSTAGRAM_FRONTEND_RETURN=https://dev.hoizr.com/me/profile

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=info                          # silent | error | warn | info | debug | trace
